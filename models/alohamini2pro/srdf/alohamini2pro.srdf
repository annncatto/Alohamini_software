<?xml version='1.0' encoding='utf-8'?>
<robot name="alohamini2pro_moveit">
  <group name="left_arm">
    <chain base_link="left_Base" tip_link="left_tcp" />
  </group>
  <group name="right_arm">
    <chain base_link="right_Base" tip_link="right_tcp" />
  </group>
  <!-- IK fallback groups: the same chains solved by the LMA plugin, used
       when the primary KDL solver diverges (it fails near the extended-arm
       configurations), and a position-only variant that drops the held TCP
       orientation when the full pose is unreachable. -->
  <group name="left_arm_lma">
    <chain base_link="left_Base" tip_link="left_tcp" />
  </group>
  <group name="right_arm_lma">
    <chain base_link="right_Base" tip_link="right_tcp" />
  </group>
  <group name="left_arm_pos">
    <chain base_link="left_Base" tip_link="left_tcp" />
  </group>
  <group name="right_arm_pos">
    <chain base_link="right_Base" tip_link="right_tcp" />
  </group>
  <group name="dual_arms">
    <group name="left_arm" />
    <group name="right_arm" />
  </group>
  <group name="left_gripper">
    <joint name="left_gripper" />
  </group>
  <group name="right_gripper">
    <joint name="right_gripper" />
  </group>
  <group name="lift">
    <joint name="vertical_move" />
  </group>
  <!-- Installed encoder Home bound to the matching folded CAD pose. -->
  <group_state name="home" group="left_arm">
    <joint name="left_shoulder_pan" value="0.0" />
    <joint name="left_shoulder_lift" value="0.0" />
    <joint name="left_elbow_flex" value="0.0" />
    <joint name="left_wrist_flex" value="1.435806017460960" />
    <joint name="left_wrist_yaw_joint" value="0.0" />
    <joint name="left_wrist_roll" value="0.0" />
  </group_state>
  <group_state name="home" group="right_arm">
    <joint name="right_shoulder_pan" value="0.0" />
    <joint name="right_shoulder_lift" value="0.0" />
    <joint name="right_elbow_flex" value="0.0" />
    <joint name="right_wrist_flex" value="1.5" />
    <joint name="right_wrist_yaw_joint" value="0.0" />
    <joint name="right_wrist_roll" value="0.0" />
  </group_state>
  <group_state name="stowed" group="left_arm">
    <joint name="left_shoulder_pan" value="0.0" />
    <joint name="left_shoulder_lift" value="0.0" />
    <joint name="left_elbow_flex" value="0.0" />
    <joint name="left_wrist_flex" value="1.435806017460960" />
    <joint name="left_wrist_yaw_joint" value="0.0" />
    <joint name="left_wrist_roll" value="0.0" />
  </group_state>
  <group_state name="stowed" group="right_arm">
    <joint name="right_shoulder_pan" value="0.0" />
    <joint name="right_shoulder_lift" value="0.0" />
    <joint name="right_elbow_flex" value="0.0" />
    <joint name="right_wrist_flex" value="1.5" />
    <joint name="right_wrist_yaw_joint" value="0.0" />
    <joint name="right_wrist_roll" value="0.0" />
  </group_state>
  <group_state name="open" group="left_gripper">
    <joint name="left_gripper" value="-1.8030294104" />
  </group_state>
  <group_state name="closed" group="left_gripper">
    <joint name="left_gripper" value="0.32" />
  </group_state>
  <group_state name="open" group="right_gripper">
    <joint name="right_gripper" value="-1.8030294104" />
  </group_state>
  <group_state name="closed" group="right_gripper">
    <joint name="right_gripper" value="0.32" />
  </group_state>
  <group_state name="bottom" group="lift">
    <joint name="vertical_move" value="-0.3" />
  </group_state>
  <group_state name="middle" group="lift">
    <joint name="vertical_move" value="0.0" />
  </group_state>
  <group_state name="top" group="lift">
    <joint name="vertical_move" value="0.3" />
  </group_state>
  <end_effector name="left_gripper_eef" parent_link="left_Fixed_Jaw" group="left_gripper" parent_group="left_arm" />
  <end_effector name="right_gripper_eef" parent_link="right_Fixed_Jaw" group="right_gripper" parent_group="right_arm" />
  <passive_joint name="wheel1_joint" />
  <passive_joint name="wheel2_joint" />
  <passive_joint name="wheel3_joint" />
  <disable_collisions link1="root" link2="root_x_link" reason="Adjacent" />
  <disable_collisions link1="root_x_link" link2="root_y_link" reason="Adjacent" />
  <disable_collisions link1="root_y_link" link2="base_link" reason="Adjacent" />
  <disable_collisions link1="base_link" link2="base_cad_link" reason="Adjacent" />
  <disable_collisions link1="base_cad_link" link2="vertical_link" reason="Adjacent" />
  <disable_collisions link1="vertical_link" link2="chest_camera" reason="Adjacent" />
  <disable_collisions link1="base_cad_link" link2="wheel1" reason="Adjacent" />
  <disable_collisions link1="base_cad_link" link2="wheel2" reason="Adjacent" />
  <disable_collisions link1="base_cad_link" link2="wheel3" reason="Adjacent" />
  <disable_collisions link1="base_cad_link" link2="back_camera" reason="Adjacent" />
  <disable_collisions link1="base_cad_link" link2="front_camera" reason="Adjacent" />
  <disable_collisions link1="vertical_link" link2="left_Base" reason="Adjacent" />
  <disable_collisions link1="left_Base" link2="left_Rotation_Pitch" reason="Adjacent" />
  <disable_collisions link1="left_Rotation_Pitch" link2="left_Upper_Arm" reason="Adjacent" />
  <disable_collisions link1="left_Upper_Arm" link2="left_Lower_Arm" reason="Adjacent" />
  <disable_collisions link1="left_Lower_Arm" link2="left_Wrist_Pitch_Roll" reason="Adjacent" />
  <disable_collisions link1="left_Wrist_Pitch_Roll" link2="left_wrist_yaw" reason="Adjacent" />
  <disable_collisions link1="left_wrist_yaw" link2="left_Fixed_Jaw" reason="Adjacent" />
  <disable_collisions link1="left_Fixed_Jaw" link2="left_Moving_Jaw" reason="Adjacent" />
  <disable_collisions link1="left_Fixed_Jaw" link2="left_camera" reason="Adjacent" />
  <disable_collisions link1="vertical_link" link2="right_Base" reason="Adjacent" />
  <disable_collisions link1="right_Base" link2="right_Rotation_Pitch" reason="Adjacent" />
  <disable_collisions link1="right_Rotation_Pitch" link2="right_Upper_Arm" reason="Adjacent" />
  <disable_collisions link1="right_Upper_Arm" link2="right_Lower_Arm" reason="Adjacent" />
  <disable_collisions link1="right_Lower_Arm" link2="right_Wrist_Pitch_Roll" reason="Adjacent" />
  <disable_collisions link1="right_Wrist_Pitch_Roll" link2="right_wrist_yaw" reason="Adjacent" />
  <disable_collisions link1="right_wrist_yaw" link2="right_Fixed_Jaw" reason="Adjacent" />
  <disable_collisions link1="right_Fixed_Jaw" link2="right_Moving_Jaw" reason="Adjacent" />
  <disable_collisions link1="right_Fixed_Jaw" link2="right_camera" reason="Adjacent" />
  <disable_collisions link1="base_cad_link" link2="chest_camera" reason="default" />
  <disable_collisions link1="base_cad_link" link2="left_Base" reason="default" />
  <disable_collisions link1="base_cad_link" link2="right_Base" reason="default" />
  <disable_collisions link1="left_Lower_Arm" link2="left_wrist_yaw" reason="default" />
  <disable_collisions link1="left_wrist_yaw" link2="left_Moving_Jaw" reason="default" />
  <disable_collisions link1="left_wrist_yaw" link2="left_camera" reason="default" />
  <disable_collisions link1="right_Lower_Arm" link2="right_wrist_yaw" reason="default" />
  <disable_collisions link1="right_wrist_yaw" link2="right_Moving_Jaw" reason="default" />
  <disable_collisions link1="right_wrist_yaw" link2="right_camera" reason="default" />
</robot>
