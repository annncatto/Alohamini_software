<?xml version="1.0"?>
<sdf version="1.8">
  <world name="lift_pick_place">
    <physics name="fast_stable" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>
    <gravity>0 0 -9.80665</gravity>

    <plugin filename="libignition-gazebo-physics-system.so" name="ignition::gazebo::systems::Physics"/>
    <plugin filename="libignition-gazebo-user-commands-system.so" name="ignition::gazebo::systems::UserCommands"/>
    <plugin filename="libignition-gazebo-scene-broadcaster-system.so" name="ignition::gazebo::systems::SceneBroadcaster"/>
    <plugin filename="libignition-gazebo-contact-system.so" name="ignition::gazebo::systems::Contact"/>

    <scene>
      <ambient>0.55 0.57 0.60 1</ambient>
      <background>0.075 0.085 0.10 1</background>
      <shadows>true</shadows>
      <grid>false</grid>
    </scene>

    <light name="soft_key" type="directional">
      <pose>-1.5 -1.0 3.5 0 0 0</pose>
      <cast_shadows>true</cast_shadows>
      <intensity>1.1</intensity>
      <direction>0.35 0.25 -0.90</direction>
      <diffuse>0.96 0.93 0.87 1</diffuse>
      <specular>0.20 0.20 0.20 1</specular>
    </light>
    <light name="soft_fill" type="point">
      <pose>1.0 1.4 2.5 0 0 0</pose>
      <cast_shadows>false</cast_shadows>
      <intensity>0.55</intensity>
      <diffuse>0.68 0.78 0.94 1</diffuse>
      <attenuation><range>8</range><constant>0.8</constant><linear>0.08</linear><quadratic>0.01</quadratic></attenuation>
    </light>

    <model name="studio_floor">
      <static>true</static>
      <link name="floor">
        <collision name="collision">
          <pose>0 0 -0.025 0 0 0</pose>
          <geometry><box><size>4.0 3.0 0.05</size></box></geometry>
          <surface><friction><ode><mu>0.9</mu><mu2>0.9</mu2></ode></friction></surface>
        </collision>
        <visual name="visual">
          <pose>0 0 -0.025 0 0 0</pose>
          <geometry><box><size>4.0 3.0 0.05</size></box></geometry>
          <material>
            <ambient>0.36 0.38 0.40 1</ambient>
            <diffuse>0.45 0.47 0.49 1</diffuse>
            <roughness><metal><roughness>0.82</roughness><metalness>0.0</metalness></metal></roughness>
          </material>
        </visual>
      </link>
    </model>

    <model name="backdrop">
      <static>true</static>
      <link name="walls">
        <visual name="back_wall"><pose>0 1.49 1.0 0 0 0</pose><geometry><box><size>4.0 0.02 2.0</size></box></geometry><material><ambient>0.18 0.20 0.22 1</ambient><diffuse>0.23 0.25 0.27 1</diffuse></material></visual>
        <visual name="side_wall"><pose>1.99 0 1.0 0 0 0</pose><geometry><box><size>0.02 3.0 2.0</size></box></geometry><material><ambient>0.15 0.17 0.19 1</ambient><diffuse>0.20 0.22 0.24 1</diffuse></material></visual>
      </link>
    </model>

    <include>
      <uri>model://high_plinth</uri>
      <name>pick_plinth</name>
      <pose>0.65 -0.56 0 0 0 0</pose>
    </include>
    <include>
      <uri>model://grasp_object</uri>
      <name>demo_object</name>
      <!-- At the near corner of the high platform so the base stays clear of
           the pedestal while the right arm approaches. -->
      <pose>0.50 -0.40 0.633 0 0 0</pose>
    </include>
    <include>
      <uri>model://aruco_drop_zone</uri>
      <name>drop_zone</name>
      <pose>0.70 0.72 0 0 0 0</pose>
    </include>

    <gui fullscreen="false">
      <plugin filename="GzScene3D" name="3D View">
        <gz-gui><title>Lift Pick and Place</title><property type="bool" key="showTitleBar">false</property><property type="string" key="state">docked</property></gz-gui>
        <engine>ogre2</engine>
        <scene>scene</scene>
        <ambient_light>0.55 0.57 0.60</ambient_light>
        <camera_pose>-2.65 -2.35 1.75 0 0.38 0.73</camera_pose>
      </plugin>
      <plugin filename="WorldControl" name="World control"><gz-gui><title>World control</title><property type="bool" key="showTitleBar">false</property><property type="bool" key="resizable">false</property><property type="double" key="height">72</property><property type="double" key="width">121</property><property type="double" key="z">1</property><property type="string" key="state">floating</property><anchors target="3D View"><line own="left" target="left"/><line own="bottom" target="bottom"/></anchors></gz-gui><play_pause>true</play_pause><step>true</step><start_paused>false</start_paused></plugin>
      <plugin filename="WorldStats" name="World stats"><gz-gui><title>World stats</title><property type="bool" key="showTitleBar">false</property><property type="bool" key="resizable">false</property><property type="double" key="height">110</property><property type="double" key="width">290</property><property type="double" key="z">1</property><property type="string" key="state">floating</property><anchors target="3D View"><line own="right" target="right"/><line own="bottom" target="bottom"/></anchors></gz-gui><sim_time>true</sim_time><real_time_factor>true</real_time_factor><iterations>true</iterations></plugin>
    </gui>
  </world>
</sdf>
