<?xml version="1.0"?>
<package format="3">
  <name>alohamini_calibration</name>
  <version>0.1.0</version>
  <description>Read-only hardware mapping and camera calibration tools for AlohaMini.</description>
  <maintainer email="anncatto@users.noreply.github.com">anncatto</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <exec_depend>python3-yaml</exec_depend>
  <exec_depend>python3-zmq</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-opencv</exec_depend>
  <exec_depend>python3-pil</exec_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>alohamini_core</exec_depend>
  <exec_depend>alohamini_camera</exec_depend>
  <exec_depend>rsync</exec_depend>
  <test_depend>ament_cmake_pytest</test_depend>
  <test_depend>alohamini_bridge</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
