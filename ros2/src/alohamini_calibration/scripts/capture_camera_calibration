#!/usr/bin/python3
"""Capture unique JPEG frames directly from the Host camera-only stream."""

from __future__ import annotations

import argparse
import hashlib
import math
import os
import sys
import time
from datetime import datetime, timezone
from pathlib import Path

import cv2
import numpy as np
import zmq
from alohamini_camera.protocol import parse_camera_message
from calibration_io import camera_name, capture_path, save_manifest


def show_preview(
    window_name: str,
    jpeg: bytes,
    camera: str,
    captured: int,
    requested: int,
) -> bool:
    """Show one JPEG frame; return False when the operator requests exit."""
    frame = cv2.imdecode(np.frombuffer(jpeg, dtype=np.uint8), cv2.IMREAD_COLOR)
    if frame is None:
        raise ValueError("OpenCV could not decode Host camera JPEG")
    cv2.putText(
        frame,
        f"{camera}  saved {captured}/{requested}  [Q/ESC: finish]",
        (16, 32),
        cv2.FONT_HERSHEY_SIMPLEX,
        0.7,
        (0, 255, 0),
        2,
        cv2.LINE_AA,
    )
    cv2.imshow(window_name, frame)
    key = cv2.waitKey(1) & 0xFF
    return key not in (ord("q"), ord("Q"), 27)


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--host", required=True)
    parser.add_argument("--port", type=int, default=5557)
    parser.add_argument("--camera", type=camera_name, required=True)
    parser.add_argument("--output", type=Path)
    parser.add_argument("--count", type=int, default=40)
    parser.add_argument("--min-interval-sec", type=float, default=0.20)
    parser.add_argument("--timeout-sec", type=float, default=5.0)
    parser.add_argument(
        "--no-preview",
        action="store_true",
        help="disable the OpenCV window (for headless capture)",
    )
    args = parser.parse_args()
    if (
        args.count < 1
        or args.min_interval_sec < 0.0
        or args.timeout_sec <= 0.0
        or not all(map(math.isfinite, (args.min_interval_sec, args.timeout_sec)))
    ):
        raise ValueError("count and timeout must be positive; interval cannot be negative")
    preview_enabled = not args.no_preview
    if preview_enabled and not (os.environ.get("DISPLAY") or os.environ.get("WAYLAND_DISPLAY")):
        raise RuntimeError(
            "preview requested but no graphical display is available; pass --no-preview"
        )
    args.output = capture_path(args.camera, "intrinsics", args.output)
    print(f"Capture directory: {args.output}")
    context = zmq.Context()
    socket = context.socket(zmq.SUB)
    socket.setsockopt(zmq.LINGER, 0)
    socket.setsockopt(zmq.RCVHWM, 2)
    socket.setsockopt(zmq.MAXMSGSIZE, 8 * 1024 * 1024)
    socket.setsockopt(zmq.SUBSCRIBE, f"camera/{args.camera}".encode())
    socket.connect(f"tcp://{args.host}:{args.port}")
    samples = []
    manifest = {
        "schema_version": 1,
        "status": "raw_capture",
        "captured_at": datetime.now(timezone.utc).isoformat(),
        "camera_name": args.camera,
        "requested_samples": args.count,
        "captured_samples": 0,
        "source": {
            "transport": "alohamini_host_camera_stream_v1",
            "host": args.host,
            "port": args.port,
        },
        "samples": samples,
    }
    session = None
    dimensions = None
    last_sequence = 0
    last_saved = 0.0
    deadline = time.monotonic() + args.timeout_sec
    window_name = f"AlohaMini intrinsic capture: {args.camera}"
    try:
        save_manifest(args.output, manifest)
        if preview_enabled:
            cv2.namedWindow(window_name, cv2.WINDOW_NORMAL | cv2.WINDOW_KEEPRATIO)
            cv2.resizeWindow(window_name, 960, 540)
        while len(samples) < args.count:
            if time.monotonic() >= deadline:
                raise TimeoutError("timed out waiting for a new Host camera frame")
            if not socket.poll(100, zmq.POLLIN):
                continue
            frame = parse_camera_message(socket.recv_multipart())
            if frame.camera_name != args.camera:
                continue
            if not frame.host_session_id:
                raise ValueError("camera stream requires a Host session ID")
            if session is not None and session != frame.host_session_id:
                raise ValueError("Host session changed; start a new capture")
            session = frame.host_session_id
            if frame.sequence <= last_sequence:
                continue
            if dimensions is not None and dimensions != (frame.width, frame.height):
                raise ValueError("camera resolution changed; start a new capture")
            dimensions = (frame.width, frame.height)
            jpeg = frame.jpeg
            decoded = cv2.imdecode(np.frombuffer(jpeg, dtype=np.uint8), cv2.IMREAD_COLOR)
            if decoded is None or decoded.shape[1::-1] != dimensions:
                raise ValueError("JPEG dimensions do not match camera metadata")
            last_sequence = frame.sequence
            deadline = time.monotonic() + args.timeout_sec
            now = time.monotonic()
            if now - last_saved >= args.min_interval_sec:
                index = len(samples)
                filename = f"{args.camera}_{index:04d}.jpg"
                path = args.output / filename
                path.write_bytes(jpeg)
                samples.append(
                    {
                        "file": filename,
                        "sequence": frame.sequence,
                        "host_session_id": session,
                        "capture_monotonic_s": frame.capture_monotonic_s,
                        "capture_unix_ns": frame.capture_unix_ns,
                        "sha256": hashlib.sha256(jpeg).hexdigest(),
                    }
                )
                manifest["captured_samples"] = len(samples)
                save_manifest(args.output, manifest)
                last_saved = now
                print(
                    f"[{len(samples):03d}/{args.count:03d}] {filename}",
                    file=sys.stderr,
                )
            if preview_enabled and not show_preview(
                window_name, jpeg, args.camera, len(samples), args.count
            ):
                print("Capture finished by operator.", file=sys.stderr)
                break
    except KeyboardInterrupt:
        pass
    finally:
        socket.close(linger=0)
        context.term()
        if preview_enabled:
            cv2.destroyAllWindows()
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
