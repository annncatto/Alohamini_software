#!/usr/bin/python3
"""Generate print-ready A4 PNG and PDF assets from a ChArUco board YAML."""

from __future__ import annotations

import argparse
import math
from pathlib import Path

import numpy as np
from camera_board import create_charuco_board, draw_board, load_board
from PIL import Image

from alohamini.paths import WorkspacePaths

MM_PER_INCH = 25.4


def pixels(mm: float, dpi: int) -> int:
    return int(round(mm * dpi / MM_PER_INCH))


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--board", type=Path, required=True)
    parser.add_argument("--output-dir", type=Path)
    args = parser.parse_args()

    config = load_board(args.board)
    if config["target_type"] != "charuco":
        raise ValueError("print generation requires a ChArUco board")
    print_config = config["print"]
    dpi = int(print_config["dpi"])
    paper_width_mm, paper_height_mm = map(float, print_config["paper_size_mm"])
    board_width_mm, board_height_mm = map(float, print_config["board_size_mm"])
    if not 1 <= dpi <= 1200 or not all(
        math.isfinite(value) and value > 0
        for value in (paper_width_mm, paper_height_mm, board_width_mm, board_height_mm)
    ):
        raise ValueError("paper dimensions and DPI must be finite and positive (DPI <= 1200)")
    expected_width = int(config["squares_x"]) * float(config["square_length_m"]) * 1000.0
    expected_height = int(config["squares_y"]) * float(config["square_length_m"]) * 1000.0
    if abs(board_width_mm - expected_width) > 1e-9 or abs(board_height_mm - expected_height) > 1e-9:
        raise ValueError("print board size does not match square count and length")

    # One integer pixel count per square keeps every square exactly square.
    square_px = pixels(float(config["square_length_m"]) * 1000.0, dpi)
    board_size_px = (
        int(config["squares_x"]) * square_px,
        int(config["squares_y"]) * square_px,
    )
    paper_size_px = (pixels(paper_width_mm, dpi), pixels(paper_height_mm, dpi))
    if board_size_px[0] > paper_size_px[0] or board_size_px[1] > paper_size_px[1]:
        raise ValueError("board does not fit on the configured paper")

    board_image = draw_board(create_charuco_board(config), board_size_px)
    page = np.full((paper_size_px[1], paper_size_px[0]), 255, dtype=np.uint8)
    x = (paper_size_px[0] - board_size_px[0]) // 2
    y = (paper_size_px[1] - board_size_px[1]) // 2
    page[y : y + board_size_px[1], x : x + board_size_px[0]] = board_image

    output_dir = (
        args.output_dir or WorkspacePaths().calibration / "cameras" / "boards"
    ).expanduser()
    output_dir.mkdir(parents=True, exist_ok=True)
    png_path = output_dir / print_config["png"]
    pdf_path = output_dir / print_config["pdf"]
    for path in (png_path, pdf_path):
        if path.parent != output_dir or path.exists():
            raise ValueError(f"Print output must be a new file inside {output_dir}: {path}")
    pil_image = Image.fromarray(page, mode="L")
    with png_path.open("xb") as stream:
        pil_image.save(stream, "PNG", dpi=(dpi, dpi), optimize=True)
    with pdf_path.open("xb") as stream:
        pil_image.save(stream, "PDF", resolution=dpi)
    print(f"Wrote {png_path} ({paper_size_px[0]}x{paper_size_px[1]} at {dpi} DPI)")
    print(f"Wrote {pdf_path} (A4 landscape; print at actual size)")
    print(f"Board: {board_width_mm:.1f}x{board_height_mm:.1f} mm; square: {square_px} px")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
