<?xml version="1.0"?>
<package format="3">
  <name>alohamini_validation</name>
  <version>0.1.0</version>
  <description>Offline validation tools and golden baselines for AlohaMini description assets.</description>
  <maintainer email="anncatto@users.noreply.github.com">anncatto</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_python</buildtool_depend>
  <exec_depend>alohamini_core</exec_depend>
  <exec_depend>alohamini_description</exec_depend>
  <exec_depend>alohamini_moveit_config</exec_depend>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>builtin_interfaces</exec_depend>
  <exec_depend>moveit_msgs</exec_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
